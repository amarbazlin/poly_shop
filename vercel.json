{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].js?__forgera=/$1"
    },
    {
      "source": "/((?!api/)(?!api$).*)",
      "destination": "/index.html"
    }
  ]
}
